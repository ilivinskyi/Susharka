<Window x:Class="Susharka.Markup.MarkupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mark up" Width="900" Height="640" MinWidth="980" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#EDEEF1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#26282E" />
        <SolidColorBrush x:Key="Hover" Color="#14000000" />
        <SolidColorBrush x:Key="Selected" Color="#262F6FEB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Ink}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
        </Style>

        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Opacity="0" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="0.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#22000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F8F8FA" BorderBrush="#18000000" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="PenTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Pen (P)" IsChecked="True">
                        <Path Style="{StaticResource IconPath}" Data="M3,13 L3.4,10.4 L10.6,3.2 L12.8,5.4 L5.6,12.6 Z M9.4,4.4 L11.6,6.6" />
                    </RadioButton>
                    <RadioButton x:Name="HighlighterTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Highlighter (H)">
                        <Path Style="{StaticResource IconPath}" Data="M5,11 L5,8 L10,3 L13,6 L8,11 Z M2,14 L9,14" />
                    </RadioButton>
                    <RadioButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Arrow (A)">
                        <Path Style="{StaticResource IconPath}" Data="M3,13 L13,3 M7.5,3 L13,3 L13,8.5" />
                    </RadioButton>
                    <RadioButton x:Name="RectTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Rectangle (R)">
                        <Path Style="{StaticResource IconPath}" Data="M2.5,4 H13.5 V12 H2.5 Z" />
                    </RadioButton>
                    <RadioButton x:Name="EllipseTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Ellipse (O)">
                        <Path Style="{StaticResource IconPath}" Data="M2.5,8 A5.5,4.2 0 1 1 13.5,8 A5.5,4.2 0 1 1 2.5,8 Z" />
                    </RadioButton>
                    <RadioButton x:Name="TextTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Text (T)">
                        <Path Style="{StaticResource IconPath}" Data="M3,3.5 H13 M8,3.5 V13.5 M6,13.5 H10" />
                    </RadioButton>
                    <RadioButton x:Name="CropTool" Style="{StaticResource ToolButton}" GroupName="tool" ToolTip="Crop (C)">
                        <Path Style="{StaticResource IconPath}" Data="M4.5,1.5 V11.5 H14.5 M1.5,4.5 H11.5 V14.5" />
                    </RadioButton>

                    <Border Width="1" Height="20" Background="#22000000" Margin="8,0" />

                    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />

                    <Border Width="1" Height="20" Background="#22000000" Margin="8,0" />

                    <RadioButton x:Name="SizeS" Style="{StaticResource ToolButton}" GroupName="size" ToolTip="Thin">
                        <Ellipse Width="4" Height="4" Fill="{StaticResource Ink}" />
                    </RadioButton>
                    <RadioButton x:Name="SizeM" Style="{StaticResource ToolButton}" GroupName="size" ToolTip="Medium" IsChecked="True">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Ink}" />
                    </RadioButton>
                    <RadioButton x:Name="SizeL" Style="{StaticResource ToolButton}" GroupName="size" ToolTip="Thick">
                        <Ellipse Width="11" Height="11" Fill="{StaticResource Ink}" />
                    </RadioButton>

                    <Border Width="1" Height="20" Background="#22000000" Margin="8,0" />

                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" ToolTip="Undo (Ctrl+Z)" Click="OnUndo">
                        <Path Style="{StaticResource IconPath}" Data="M5.5,3.5 L2.5,6.5 L5.5,9.5 M2.5,6.5 H10 A3.5,3.5 0 0 1 10,13.5 H7" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Y)" Click="OnRedo">
                        <Path Style="{StaticResource IconPath}" Data="M10.5,3.5 L13.5,6.5 L10.5,9.5 M13.5,6.5 H6 A3.5,3.5 0 0 0 6,13.5 H9" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TextButton}" Content="Cancel" Click="OnCancel" ToolTip="Esc" />
                    <Button Style="{StaticResource TextButton}" Content="Done" Click="OnDone" ToolTip="Ctrl+S"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Canvas -->
        <Grid x:Name="Stage" Margin="18" ClipToBounds="False">
            <Viewbox x:Name="View" Stretch="Uniform" StretchDirection="DownOnly">
                <Border x:Name="PaperShadow">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.18" />
                    </Border.Effect>
                    <Canvas x:Name="CropHost" ClipToBounds="True" Background="White">
                        <Grid x:Name="Surface" Background="Transparent">
                            <Image x:Name="Photo" Stretch="Fill" />
                            <InkCanvas x:Name="Ink" Background="Transparent" />
                            <Canvas x:Name="Shapes" Background="Transparent" IsHitTestVisible="False" />
                            <Canvas x:Name="CropLayer" IsHitTestVisible="False" />
                        </Grid>
                    </Canvas>
                </Border>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>
