<Window x:Class="Susharka.Preferences.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Susharka.Preferences"
        Title="Susharka Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1C1D21"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2F6FEB" />
        <SolidColorBrush x:Key="Muted" Color="#6B6E76" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#14000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Toggle switch look for CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#D5D7DC" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.25" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Margin" Value="21,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1C1D21" />
            <Setter Property="BorderBrush" Value="#26000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F1F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20,22,18">
        <StackPanel Orientation="Horizontal" Margin="2,0,0,18">
            <Image x:Name="AppIcon" Width="40" Height="40" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Susharka" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock Text="Every screenshot, within reach." Style="{StaticResource Hint}" />
            </StackPanel>
        </StackPanel>

        <!-- Shortcuts -->
        <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Take a screenshot" VerticalAlignment="Center" />
                    <p:HotKeyBox x:Name="CaptureKey" Grid.Column="1" />
                </Grid>
                <Border Height="1" Background="#10000000" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show or hide the line" VerticalAlignment="Center" />
                    <p:HotKeyBox x:Name="ToggleKey" Grid.Column="1" />
                </Grid>
                <TextBlock x:Name="KeyProblem" Foreground="#C62828" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Line -->
        <TextBlock Text="THE LINE" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reveal after resting at the top" />
                    </StackPanel>
                    <Slider x:Name="RevealDelay" Grid.Column="1" Minimum="0.1" Maximum="2" SmallChange="0.05" LargeChange="0.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock x:Name="RevealDelayText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="#10000000" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Photos on the line" VerticalAlignment="Center" />
                    <Slider x:Name="MaxItems" Grid.Column="1" Minimum="1" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                            SmallChange="1" LargeChange="2" VerticalAlignment="Center" />
                    <TextBlock x:Name="MaxItemsText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="When the line is full, the oldest photo falls off. Its file stays in your folder." Style="{StaticResource Hint}" Margin="0,0,0,10" />
            </StackPanel>
        </Border>

        <!-- Screenshots -->
        <TextBlock Text="SCREENSHOTS" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                        <TextBlock Text="Save to" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open" Style="{StaticResource PlainButton}" Click="OnOpenFolder" />
                        <Button Content="Change…" Style="{StaticResource PlainButton}" Click="OnChangeFolder" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#10000000" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,6,12,6">
                        <TextBlock Text="Hang Windows screenshots too" />
                        <TextBlock Text="Snipping Tool and Win + PrtScn captures saved to Pictures\Screenshots" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <CheckBox x:Name="WatchWindows" Grid.Column="1" />
                </Grid>
                <Border Height="1" Background="#10000000" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Copy new screenshots to the clipboard" VerticalAlignment="Center" />
                    <CheckBox x:Name="CopyOnCapture" Grid.Column="1" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- General -->
        <TextBlock Text="GENERAL" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sounds" VerticalAlignment="Center" />
                    <CheckBox x:Name="SoundsBox" Grid.Column="1" />
                </Grid>
                <Border Height="1" Background="#10000000" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Open at login" VerticalAlignment="Center" />
                    <CheckBox x:Name="LoginBox" Grid.Column="1" />
                </Grid>
            </StackPanel>
        </Border>

        <DockPanel Margin="2,4,0,0">
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource PlainButton}" Click="OnClose"
                    Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" MinWidth="80" />
            <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</Window>
